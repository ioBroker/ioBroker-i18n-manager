{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "paths": {
      "@common/*": ["./common/*"]
    }
  },
  "include": [
    "main/**/*.ts",
    "preload/**/*.ts",
    "common/**/*.ts",
    "electron.vite.config.ts"
  ],
  "exclude": ["node_modules", "out", "dist", "build"]
}

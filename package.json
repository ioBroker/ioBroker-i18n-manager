{
  "name": "i18n-manager",
  "version": "4.0.2",
  "main": "out/main/index.js",
  "license": "MIT",
  "description": "The app that will help to manage your app translations",
  "author": {
    "email": "gilmarsquinelato@gmail.com",
    "name": "Gilmar Quinelato",
    "url": "https://www.github.com/gilmarsquinelato"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "clean": "rimraf out dist build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "rimraf": "^6.1.3",
    "sass": "^1.100.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.3",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "^3.3.2"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@mdi/font": "^7.4.47",
    "axios": "^1.16.1",
    "deepmerge": "^4.3.1",
    "fast-deep-equal": "^3.1.3",
    "js-yaml": "^4.1.1",
    "lodash": "^4.18.1",
    "node-watch": "^0.7.4",
    "pinia": "^3.0.4",
    "roboto-fontface": "^0.10.0",
    "vue": "^3.5.34",
    "vue-router": "^4.6.4",
    "vue-virtual-scroller": "^3.0.4",
    "vuetify": "^4.0.7"
  },
  "build": {
    "productName": "i18n Manager",
    "appId": "com.i18n-manager.app",
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "icons/**/*",
      "package.json"
    ],
    "icon": "./icons/icon.png",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Folder",
            "CFBundleTypeOSTypes": [
              "fold"
            ],
            "CFBundleTypeRole": "Editor",
            "LSIsAppleDefaultForType": true
          }
        ]
      }
    },
    "linux": {
      "category": "Development"
    },
    "win": {
      "target": "portable"
    }
  }
}
